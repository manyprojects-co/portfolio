---
/**
 * 404. Required by wrangler.jsonc's `not_found_handling: "404-page"` — without this file
 * Cloudflare falls back to its own generic error page.
 *
 * ⚠︎ UNREVIEWED DESIGN. Deliberately minimal and built only from existing tokens; it has
 * had no in-browser review. Treat as a placeholder for a real 404 pass.
 */
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Not found — Many Projects</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <style>
      .nf { padding: var(--frame-margin); font-size: var(--type-size); line-height: 1.5; }
      .nf a { color: inherit; }
    </style>
  </head>
  <body>
    <div class="nf">
      <p>That page isn’t here.</p>
      <p><a href="/">Many Projects</a></p>
    </div>
  </body>
</html>
