---
/**
 * The landing. Panels are PRE-RENDERED from CMS content — v6 built these in the browser
 * from inline arrays that went stale twice in a week.
 *
 * ⚠︎ P4 SEAM: the detail card is still built client-side from the JSON payload below.
 * The locked architecture (hooks.md § Detail-route architecture) says fetch a `_content`
 * partial on click instead, with `/[type]/[slug]` pre-rendering the card already open.
 * When those routes land, this payload shrinks to nothing.
 */
import { getCollection, getEntry } from "astro:content";
import Site from "../layouts/Site.astro";
import Carousel from "../components/Carousel.astro";
import Nav from "../components/Nav.astro";
import ArtGrid from "../components/ArtGrid.astro";
import NewsList from "../components/NewsList.astro";
import Bio from "../components/Bio.astro";
import { mapWork, mapNews, featuredWorks, newsNewestFirst } from "../lib/map";

const works = (await getCollection("artworks")).map(mapWork);
const news = newsNewestFirst((await getCollection("news")).map(mapNews));
const about = (await getEntry("about", "about"))!.data;
const contact = (await getEntry("contact", "contact"))!.data;

const featured = featuredWorks(works);
// Grid order: featured first by featureOrder, then the rest. v6 sorted by a synthetic
// `order: 999` default; the schema has no order for unfeatured works, so this is explicit.
const gridWorks = [...works].sort(
  (a, b) => (a.order ?? 1e9) - (b.order ?? 1e9) || a.title.localeCompare(b.title)
);
---

<Site>
  <div class="hero">
    <Carousel works={featured} />
  </div>

  <div class="section">
    <Nav contact={contact} />
    <div class="track" id="track">
      <ArtGrid works={gridWorks} />
      <NewsList news={news} />
      <Bio about={about} />
    </div>
  </div>

  <script
    slot="data"
    id="site-data"
    type="application/json"
    is:inline
    set:html={JSON.stringify({ works, news })}
  />
</Site>
