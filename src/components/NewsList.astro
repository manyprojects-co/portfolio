---
/**
 * NEWS panel — reverse-chronological (DECIDED 2026-08-06; no CMS field for order).
 * `timeElapsed` is baked for first paint and refreshed by site.js — see format.ts.
 */
import Media from "./Media.astro";
import { titleCase, typeLabel, timeElapsed } from "../lib/format";
/* ⛔ `specialTypes` REMOVED (2026-08-23, JJ) — see the note in global.css. The prop drove a
   raised-panel treatment that had been switched off and would have matched one item. */
interface Props { news: any[] }
const { news } = Astro.props;
---
<div class="sub" id="news">
  <div class="news-list" id="newsList">
    {news.map((item) => (
      <article class="news-item">
        <a class="ni-inner" href={`/news/${item.slug}`} data-detail={`news/${item.slug}`}>
          {/* ⚠︎ `ratio` SHAPES THE EMPTY PLACEHOLDER ONLY — the real image is shaped by
              `.ni-img`'s aspect-ratio. Keep this in step with --news-img-ratio in
              global.css or an empty row is a different shape from a filled one.
              ⚠︎ `sizes` tracks --news-img-w (0.8 x --art-side-w = 240). It said "200px"
              when the thumbnail was 220, so the browser had been picking one candidate too
              small and upscaling it all along. */}
          <Media media={item.image} alt={item.title} class="ni-img"
                 widths={[240, 480, 720]} sizes="240px" ratio={[4, 3]} />
          <div class="ni-text">
            <div class="ni-meta">
              <span>{typeLabel(item.eventType)}</span>
              <span class="ni-sep">·</span>
              <span data-elapsed={item.date?.toISOString().slice(0, 10)}>
                {item.date ? timeElapsed(item.date) : ""}
              </span>
            </div>
            <p class="ni-heading">
              <span class="ni-title">{titleCase(item.title)}</span>
              {item.subheading && <>: <span class="ni-sub">{item.subheading}</span></>}
            </p>
          </div>
        </a>
      </article>
    ))}
  </div>
</div>
