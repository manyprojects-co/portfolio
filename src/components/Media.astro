---
/**
 * Media.astro — P2's `<Img>` wrapper, and the ENTIRE image surface area of the site.
 * Every image and video goes through this. Origin changes are a one-line swap here.
 *
 * DELIVERY (research-notes §5, LOCKED; amended 2026-08-13 for R2):
 *   prod -> https://<TRANSFORM_HOST>/cdn-cgi/image/width=W,format=auto/<src>
 *   dev  -> <src> raw                                  /cdn-cgi/image only exists on CF
 *
 * ⚠︎ THE TRANSFORM URL IS ABSOLUTE, AND THAT IS DELIBERATE (2026-08-23). A RELATIVE
 * `/cdn-cgi/image/...` only resolves on the zone, so every branch PREVIEW URL rendered
 * a page with no pictures — which made design review on a preview impossible, the exact
 * thing preview URLs exist for. Pinning the host costs nothing on the live site (same
 * zone, same edge) and makes previews work. Open question 6 in `motion-fork-brief.md`.
 *
 * ⚠︎ THE EMPTY STATE MUST STAY SAFE. It was the default case when this was written (every
 * visual empty as of 2026-08-13); every URL has been filled since 2026-09-07, but the CMS
 * still has no media picker, so a missing, blank, or malformed src must render a placeholder,
 * never a broken <img>. That placeholder is PENDING ("no URL"), not LOADING — the loading
 * state is handled by `width`/`height` from the manifest below (brief, R4).
 *
 * ⚠︎ Sources must be on an ALLOWED ORIGIN or the transform is rejected. `media.agawen.com`
 * requires `*.agawen.com` under Images -> Transformations -> Sources; a root domain does
 * NOT cover its subdomains. And `r2.dev` can never work here — it is outside the zone.
 */
import { normaliseMediaUrl, TRANSFORM_HOST, type MediaDims } from "../lib/media-origin";
import { blocksHtml } from "../lib/format";
/**
 * ⭐ THE MANIFEST (2026-10-27, placeholder-fork-brief.md § MANIFEST). `{ url: { w, h } }` for
 * every image the content refers to, measured once at the edge by `npm run media:dims` and
 * committed. Imported as plain JSON through Vite — deliberately NOT through
 * `content.config.ts`, whose `.astro/data-store.json` cache survives HMR and makes a new
 * field read as absent (brief, T5). The file always exists (`{}` at minimum) because a
 * missing JSON import would fail the build, and the manifest must never be able to (R1).
 */
import manifest from "../../content/media-dimensions.json";
const dims = manifest as Record<string, MediaDims>;

interface Props {
  media?: { kind: "image" | "video" | "text"; src: string; text?: string; caption?: string } | null;
  alt?: string;
  widths?: number[];
  sizes?: string;
  /**
   * ⚠︎ THE SHAPE OF THE EMPTY PLACEHOLDER ONLY. It never crops or constrains a real image.
   *
   * A real image's box is driven by its OWN intrinsic dimensions, because that variation is
   * the design: `.artwork { height: var(--card-h); width: auto }` gives every carousel card
   * a different width, and `.detail-hero { width: 100%; height: auto }` is commented in the
   * CSS as "height always proportional". An empty <div> has no intrinsic size, so the
   * placeholder needs a shape or the carousel collapses to zero scroll width — but that
   * shape must not leak onto the real thing.
   *
   * Regression this prevents (JJ, 2026-08-14): "images on the carousel are all uniformly
   * scaled, when in actuality their container dimensions should match those of the image."
   * The first version of this component passed `ratio` into BOTH the transform
   * (`height=..,fit=cover`, a server-side crop) AND an inline `aspect-ratio` on the <img>.
   * Every card came out the same shape. Cropping is CSS's job where it is wanted at all —
   * `.ni-img` does it with `aspect-ratio` + `object-fit: cover`.
   */
  ratio?: [number, number];
  class?: string;
  loading?: "lazy" | "eager";
  /**
   * ⭐ A SECOND SOURCE FOR SMALL VIEWPORTS (the mobile cover, 2026-10-27, JJ). When BOTH
   * `media` and `mobile` are images with a usable URL, the <img> is wrapped in a
   * `<picture>` whose `<source media={mobileQuery}>` carries the mobile file; the browser
   * picks it below the query and the desktop file above, and swaps on resize. Otherwise
   * nothing changes — no wrapper, no `<picture>` — so every other surface renders exactly
   * as before (R3: the carousel sizes the <img> from its intrinsic size; a wrapper that is
   * not `display: contents` would take that over. `.media-picture` IS `display: contents`).
   * ⚠︎ `mobileQuery` MUST MATCH the CSS mobile query in global.css (`max-width: 600px`), or
   * the picture and its 4:5 crop switch at different widths. Convention for the file:
   * `<slug>-mcard.<ext>` next to `<slug>-card.<ext>` (`.pages.yml`, `data:report` lints it).
   * The `width`/`height` hint and the lqip stay those of the DESKTOP master: on mobile the
   * CSS fixes the box with `aspect-ratio: 4/5` anyway, and the impression is a blurred
   * wash of the same picture — close enough, and the load handler clears it either way.
   */
  mobile?: Props["media"];
  mobileQuery?: string;
}
const {
  media = null, alt = "", widths = [640, 1280, 1920], sizes = "100vw",
  ratio, class: cls = "", loading = "lazy",
  mobile = null, mobileQuery = "(max-width: 600px)",
} = Astro.props;

/**
 * Build one transform URL. WIDTH ONLY — Cloudflare preserves the source aspect when no
 * height is given, so the image keeps its own proportions and the browser derives the box
 * from them. Never add `height`/`fit=cover` here: that is a server-side crop, and it made
 * every carousel card identical.
 */
function tx(src: string, w: number) {
  if (!import.meta.env.PROD || !transformable) return src;
  return `https://${TRANSFORM_HOST}/cdn-cgi/image/width=${w},format=auto/${src}`;
}

/**
 * ⚠︎ URLs are hand-pasted with no picker, so validate rather than trust. An off-origin or
 * r2.dev URL still RENDERS (a broken page helps nobody) but is never sent through the
 * transform — a transform on a disallowed source is rejected outright — and it shouts in
 * dev. `npm run data:report` counts these across the whole CMS.
 */
const verdict = normaliseMediaUrl(media?.src);
const src = verdict.ok ? verdict.url : (media?.src?.trim() ?? "");
const ok = src.length > 0;
const transformable = verdict.ok;
if (!verdict.ok && verdict.url && import.meta.env.DEV) {
  console.warn(`[Media] ${verdict.reason}\n         ${verdict.url}`);
}
// applied to the placeholder ONLY — see the note on `ratio`
const emptyStyle = ratio ? `aspect-ratio:${ratio[0]}/${ratio[1]}` : undefined;
/**
 * ⚠︎ T1 — LOOK UP BY `verdict.url`, NEVER BY THE RAW STRING. `media-dims.mjs` keys the
 * manifest by `normaliseMediaUrl(raw).url`, and a bare path and an absolute URL normalise to
 * different string shapes. Same function, same key, both sides; a wrong key here would not
 * throw — every image would just quietly keep its zero-width load.
 * ⛔ R1 — a miss is `undefined`, and Astro omits an undefined attribute. The image then
 * behaves exactly as it did before the manifest existed.
 */
const dim = transformable && media?.kind === "image" ? dims[src] : undefined;
/* The mobile source: same normalisation, same transform rule, its own verdict. */
const mv = normaliseMediaUrl(mobile?.src);
const mobileSrc = mv.ok ? mv.url : (mobile?.src?.trim() ?? "");
const hasMobile = ok && media?.kind === "image" && mobile?.kind === "image" && mobileSrc.length > 0;
if (!mv.ok && mv.url && import.meta.env.DEV) {
  console.warn(`[Media] (mobile) ${mv.reason}\n         ${mv.url}`);
}
const txm = (w: number) =>
  !import.meta.env.PROD || !mv.ok ? mobileSrc : `https://${TRANSFORM_HOST}/cdn-cgi/image/width=${w},format=auto/${mobileSrc}`;
/* The <img> below carries `width`/`height` = the master's TRUE pixel size from `dim` — a
 * RATIO hint, not a size. CSS still owns the box on every surface (`.artwork { height;
 * width: auto }`, `.detail-hero { width: 100% }`, `.ni-img { aspect-ratio }`), and the browser
 * combines the hint with whichever side CSS fixes, so the box is right before any bytes land.
 * ⚠︎ On a surface that sets NO CSS width, the `width` attribute becomes the width (it is a
 * presentational hint) — `.gcard img` had exactly that and is now `width: 100%` because of it.
 * This is NOT the `ratio` prop: that shapes the empty placeholder only (see above).
 * ⛔ Comments stay up here, not inside the ternary below — a comment inside `( … )` in the
 * template broke the production build once already (hooks.md, 2026-09-30).
 * ⭐ THE <img> ATTRIBUTES ARE BUILT ONCE and spread in both branches below (plain and
 * <picture>), so the two renderings cannot drift. Anything that goes on the <img> — class,
 * style, the manifest hint — goes HERE, not in the template. */
const imgAttrs = {
  class: cls,
  width: dim?.w,
  height: dim?.h,
  src: tx(src, widths[Math.floor(widths.length / 2)]),
  srcset: widths.map((w) => `${tx(src, w)} ${w}w`).join(", "),
  sizes,
  alt,
  loading,
  decoding: "async" as const,
};
---

{
  /* ⚠︎ A TEXT ROW IS CHECKED FIRST, BEFORE THE `ok` GUARD. It has no src by definition, so
     the empty-state branch below would swallow it and render a grey placeholder box. */
  media?.kind === "text" ? (
    /* ⚠︎ `textContent` IS RICH TEXT, so inline markdown has to be rendered — without
       inlineMd a link renders as literal `[label](url)` on the page. Paragraphs split on
       blank lines, matching `paragraphs()` in map.ts so prose breaks the same way wherever
       it comes from. */
    <div class={`media-text ${cls}`}
         set:html={blocksHtml((media.text ?? "").split(/\n\s*\n/))} />
  ) : !ok ? (
    /* No source. Renders the same box the real media will occupy, so layout is honest. */
    <div class={`media-empty ${cls}`} style={emptyStyle} role="img" aria-label={alt || "Image pending"} />
  ) : media!.kind === "video" ? (
    <video class={cls} src={src} muted loop playsinline autoplay preload="metadata" />
  ) : hasMobile ? (
    <picture class="media-picture">
      <source media={mobileQuery}
              srcset={widths.map((w) => `${txm(w)} ${w}w`).join(", ")}
              sizes="100vw" />
      <img {...imgAttrs} />
    </picture>
  ) : (
    <img {...imgAttrs} />
  )
}
