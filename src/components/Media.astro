---
/**
 * Media.astro — P2's `<Img>` wrapper, and the ENTIRE image surface area of the site.
 * Every image and video goes through this. Origin changes are a one-line swap here.
 *
 * DELIVERY (research-notes §5, LOCKED; amended 2026-08-13 for R2):
 *   prod -> https://<TRANSFORM_HOST>/cdn-cgi/image/width=W,format=auto/<src>
 *   dev  -> <src> raw                                  /cdn-cgi/image only exists on CF
 *
 * ⚠︎ THE TRANSFORM URL IS ABSOLUTE, AND THAT IS DELIBERATE (2026-08-23). A RELATIVE
 * `/cdn-cgi/image/...` only resolves on the zone, so every branch PREVIEW URL rendered
 * a page with no pictures — which made design review on a preview impossible, the exact
 * thing preview URLs exist for. Pinning the host costs nothing on the live site (same
 * zone, same edge) and makes previews work. Open question 6 in `motion-fork-brief.md`.
 *
 * ⚠︎ THE EMPTY STATE IS THE DEFAULT CASE, NOT THE EDGE CASE. Every visual field is
 * empty in all 26 content files as of 2026-08-13 — the repo's images were deleted on
 * 2026-08-10 and the CMS has no media picker, so URLs are hand-pasted and most are not
 * pasted yet. A missing, blank, or malformed src must render a placeholder, never a
 * broken <img>. This is what lets P3/P4 be reviewed before a single image exists.
 *
 * ⚠︎ Sources must be on an ALLOWED ORIGIN or the transform is rejected. `media.agawen.com`
 * requires `*.agawen.com` under Images -> Transformations -> Sources; a root domain does
 * NOT cover its subdomains. And `r2.dev` can never work here — it is outside the zone.
 */
import { normaliseMediaUrl, TRANSFORM_HOST } from "../lib/media-origin";

interface Props {
  media?: { kind: "image" | "video" | "text"; src: string; text?: string; caption?: string } | null;
  alt?: string;
  widths?: number[];
  sizes?: string;
  /**
   * ⚠︎ THE SHAPE OF THE EMPTY PLACEHOLDER ONLY. It never crops or constrains a real image.
   *
   * A real image's box is driven by its OWN intrinsic dimensions, because that variation is
   * the design: `.artwork { height: var(--card-h); width: auto }` gives every carousel card
   * a different width, and `.detail-hero { width: 100%; height: auto }` is commented in the
   * CSS as "height always proportional". An empty <div> has no intrinsic size, so the
   * placeholder needs a shape or the carousel collapses to zero scroll width — but that
   * shape must not leak onto the real thing.
   *
   * Regression this prevents (JJ, 2026-08-14): "images on the carousel are all uniformly
   * scaled, when in actuality their container dimensions should match those of the image."
   * The first version of this component passed `ratio` into BOTH the transform
   * (`height=..,fit=cover`, a server-side crop) AND an inline `aspect-ratio` on the <img>.
   * Every card came out the same shape. Cropping is CSS's job where it is wanted at all —
   * `.ni-img` does it with `aspect-ratio` + `object-fit: cover`.
   */
  ratio?: [number, number];
  class?: string;
  loading?: "lazy" | "eager";
}
const {
  media = null, alt = "", widths = [640, 1280, 1920], sizes = "100vw",
  ratio, class: cls = "", loading = "lazy",
} = Astro.props;

/**
 * Build one transform URL. WIDTH ONLY — Cloudflare preserves the source aspect when no
 * height is given, so the image keeps its own proportions and the browser derives the box
 * from them. Never add `height`/`fit=cover` here: that is a server-side crop, and it made
 * every carousel card identical.
 */
function tx(src: string, w: number) {
  if (!import.meta.env.PROD || !transformable) return src;
  return `https://${TRANSFORM_HOST}/cdn-cgi/image/width=${w},format=auto/${src}`;
}

/**
 * ⚠︎ URLs are hand-pasted with no picker, so validate rather than trust. An off-origin or
 * r2.dev URL still RENDERS (a broken page helps nobody) but is never sent through the
 * transform — a transform on a disallowed source is rejected outright — and it shouts in
 * dev. `npm run data:report` counts these across the whole CMS.
 */
const verdict = normaliseMediaUrl(media?.src);
const src = verdict.ok ? verdict.url : (media?.src?.trim() ?? "");
const ok = src.length > 0;
const transformable = verdict.ok;
if (!verdict.ok && verdict.url && import.meta.env.DEV) {
  console.warn(`[Media] ${verdict.reason}\n         ${verdict.url}`);
}
// applied to the placeholder ONLY — see the note on `ratio`
const emptyStyle = ratio ? `aspect-ratio:${ratio[0]}/${ratio[1]}` : undefined;
---

{
  /* ⚠︎ A TEXT ROW IS CHECKED FIRST, BEFORE THE `ok` GUARD. It has no src by definition, so
     the empty-state branch below would swallow it and render a grey placeholder box. */
  media?.kind === "text" ? (
    <div class={`media-text ${cls}`}>
      {(media.text ?? "").split(/\n\s*\n/).map((para) => <p>{para.trim()}</p>)}
    </div>
  ) : !ok ? (
    /* No source. Renders the same box the real media will occupy, so layout is honest. */
    <div class={`media-empty ${cls}`} style={emptyStyle} role="img" aria-label={alt || "Image pending"} />
  ) : media!.kind === "video" ? (
    <video class={cls} src={src} muted loop playsinline autoplay preload="metadata" />
  ) : (
    <img
      class={cls}
      src={tx(src, widths[Math.floor(widths.length / 2)])}
      srcset={widths.map((w) => `${tx(src, w)} ${w}w`).join(", ")}
      sizes={sizes}
      alt={alt}
      loading={loading}
      decoding="async"
    />
  )
}
