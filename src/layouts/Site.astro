---
/**
 * Site.astro — the shell. Mirrors prototype-v6.html's skeleton exactly:
 *   #detail  (below, the card)  ·  #stage  (owns the detail offset)
 *   #world   (owns landing<->tab)  ·  .hero + .section
 *
 * ⚠︎ THE ORDER AND NESTING ARE LOAD-BEARING. #detail (a scroller, above) drives #stage
 * through a named scroll timeline scoped on <body>; #world owns the landing<->tab offset;
 * every geometry measurement in site.js reads from this exact tree.
 */
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
  /** Set on a detail route. Tells site.js to ADOPT the pre-rendered sheet rather than
   *  build one — and to present it AT REST, with no rise. A rise is the response to a
   *  click; arriving by URL is not a click. (hooks.md § Detail-route architecture) */
  coldOpen?: { type: "art" | "news"; slug: string } | null;
}
const {
  title = "Many Projects",
  description = "Xin Wen & JJ Agcaoili — XJ",
  coldOpen = null,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- ABOVE (card-native, 2026-09-24): #detail is now a full-viewport NATIVE SNAP SCROLLER
         sitting OVER the stage. Two snap stops: #detailSpacer (100%, transparent — the site
         shows through it) and #detailSheet (the card, 100% minus --detail-top). scrollTop 0 is
         closed; scrolled to the sheet is open, with the spacer's top 120px still showing — that
         strip IS the sliver, so a tap on it closes. The reveal (#stage rise + scale, sheet
         scale, #cardBlur veil) is a CSS scroll-driven animation on this scroller's timeline.
         MP_CMS_CF/native-snap-spike-brief.md § 1b. #detailSheet owns the grey->black ground. -->
    <div
      id="detail"
      aria-label="Artwork or news detail"
      class:list={[coldOpen && "open", coldOpen && "cold"]}
      data-cold-open={coldOpen ? `${coldOpen.type}/${coldOpen.slug}` : undefined}
    >
      <div id="detailSpacer" aria-hidden="true"></div>
      <div id="detailSheet">
        <div id="detailScroll"><div id="detailContent"><slot name="detail" /></div></div>
      </div>
    </div>

    <!-- BENEATH the card scroller: the site. #stage is driven by #detail's scroll timeline;
         #world owns the landing<->tab offset. -->
    <div id="stage">
      <div id="world">
        <slot />
      </div>
      <!-- Progressive blur over the departing site, anchored to the card boundary.
           Inside #stage and pinned to its bottom edge, so it rides the reveal for free.
           See `#cardBlur` in global.css. Purely decorative. -->
      <div id="cardBlur" aria-hidden="true"></div>
    </div>

    <slot name="data" />
    <script>import "../scripts/site.js";</script>
  </body>
</html>
