---
/**
 * Site.astro — the shell. Mirrors prototype-v6.html's skeleton exactly:
 *   #detail  (below, the card)  ·  #stage  (owns the detail offset)
 *   #world   (owns landing<->tab)  ·  .hero + .section
 *
 * ⚠︎ THE ORDER AND NESTING ARE LOad-BEARING. #stage and #world own different offsets,
 * and every geometry measurement in site.js reads from this exact tree.
 */
import "../styles/global.css";
import { aboutData } from "../lib/content";
interface Props {
  title?: string;
  description?: string;
  /** Set on a detail route. Tells site.js to ADOPT the pre-rendered sheet rather than
   *  build one — and to present it AT REST, with no rise. A rise is the response to a
   *  click; arriving by URL is not a click. (hooks.md § Detail-route architecture) */
  coldOpen?: { type: "art" | "news"; slug: string } | null;
}
const {
  title = "Many Projects",
  description = "Xin Wen & JJ Agcaoili — XJ",
  coldOpen = null,
} = Astro.props;
// Favicon from the CMS (About → Favicon URL). Empty → no <link>, the browser falls back to
// /favicon.ico, which does not exist, which is today's behaviour. The URL is pasted as-is:
// no transform (an icon is tiny) and no origin check beyond what content-report.mjs flags.
const favicon = ((await aboutData()).faviconUrl ?? "").trim();
const faviconType = /\.svg(\?|$)/i.test(favicon) ? "image/svg+xml" : /\.png(\?|$)/i.test(favicon) ? "image/png" : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {favicon && <link rel="icon" href={favicon} type={faviconType} />}
    {favicon && !faviconType?.includes("svg") && <link rel="apple-touch-icon" href={favicon} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    {/* § LQIP — the loading state's only JS (placeholder-fork-brief.md § BLUR / FADE).
        INLINE and IN THE HEAD on purpose: it must be listening before the first <img> is
        parsed. site.js is a module — it runs after the parse and after its own download —
        and on a cold load the six eager carousel images are usually `complete` by then, so a
        hook that lives there sees them as cached and the picture just jumps in (JJ, 2026-10-27).
        `load` does not bubble but it does CAPTURE, so one listener on the document sees every
        image on the page, including the card's gallery injected later by innerHTML.
        Two jobs off one event:
          T6  clear the inlined impression once the picture is there, so a transparent PNG's
              holes never show the smear afterwards;
          FADE  the picture ARRIVES blurred (.lqip-wait for one style resolve) and sharpens
              (.lqip-done, drops itself on transitionend). A filter exists for ~240ms per
              image around its arrival and at no other time — never a standing state.
        T7  cached vs fetched is decided by the fetch's DURATION (resource timing — the
            `duration` field is exposed cross-origin, so it works on previews), not by
            `img.complete`: a picture that took under LQIP_MIN_MS was ready before anyone was
            looking and must not be hazed. No timing entry → treated as cached → no blur.
        A failed image keeps its impression (❓2's interim: better than a broken icon). */}
    <script is:inline>
      (function () {
        var MIN_MS = 40; /* [TUNE] loads faster than this are "cached": no blur-up (T7) */
        function land(e) {
          var img = e.target;
          if (!(img instanceof HTMLImageElement) || !img.classList.contains("media-lqip") || img.dataset.lqip) return;
          img.dataset.lqip = "1";
          img.style.backgroundImage = "";                                   /* T6 */
          var rt = performance.getEntriesByName(img.currentSrc);
          if (!rt.length || rt[rt.length - 1].duration < MIN_MS) return;   /* T7 */
          img.classList.add("lqip-wait"); void img.offsetWidth;            /* the frame about to paint: blurred */
          img.classList.remove("lqip-wait"); img.classList.add("lqip-done"); /* …and sharpening from it */
          img.addEventListener("transitionend", function () { img.classList.remove("lqip-done"); }, { once: true });
        }
        document.addEventListener("load", land, true);
      })();
    </script>
  </head>
  <body>
    <!-- BELOW: the detail card. Rises over the site; #detail owns the grey->black ground. -->
    <div
      id="detail"
      aria-label="Artwork or news detail"
      class:list={[coldOpen && "open", coldOpen && "cold"]}
      data-cold-open={coldOpen ? `${coldOpen.type}/${coldOpen.slug}` : undefined}
    >
      <div id="detailScroll"><div id="detailContent"><slot name="detail" /></div></div>
    </div>

    <!-- ABOVE: the site. #stage owns the detail offset, #world the landing<->tab offset. -->
    <div id="stage">
      <div id="world">
        <slot />
      </div>
      <!-- Progressive blur over the departing site, anchored to the card boundary.
           Inside #stage and pinned to its bottom edge, so it rides the reveal for free.
           See `#cardBlur` in global.css. Purely decorative. -->
      <div id="cardBlur" aria-hidden="true"></div>
    </div>

    <slot name="data" />
    <script>import "../scripts/site.js";</script>
  </body>
</html>
